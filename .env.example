# Copy to .env and fill in. NEVER commit your real .env.

# Live trading is OFF unless this is exactly "true" AND config mode is "live".
LIVE_TRADING=false

# Binance (public market data needs no key; keys only required for private endpoints)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Polymarket CLOB credentials (only needed for live order placement)
# Get these from your Polygon wallet / py-clob-client API key derivation.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_FUNDER_ADDRESS=

# Optional override of the config file path
BOT_CONFIG=config.yaml
